{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commonplace.app/schema/gold.schema.json",
  "title": "Commonplace gold record",
  "description": "One human-verified gold record per item (a JSONL line), the ground truth the metric harness scores against (evaluation-methodology.md §3). Every layer block is optional except `item_id`. mentions[*]: exactly one of `gold_id` (object) or `nil` (\"NIL_NO_ID\"/\"NON_ENTITY\") is non-null; `nil=\"NIL_NO_ID\"` requires non-empty `failed_queries` (Learn-to-Not-Link). Facet values are checked against `vocab/facets.json` at runtime by schema_gate.validate_gold_record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["item_id"],
  "properties": {
    "item_id": { "type": "string" },
    "strata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "has_vtt": { "type": "boolean" },
        "is_slideshow": { "type": "boolean" },
        "duration_tercile": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "mentions": { "type": "array", "items": { "$ref": "#/$defs/GoldMention" } },
    "concepts": { "type": "array", "items": { "$ref": "#/$defs/GoldConcept" } },
    "facets": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "structured": { "type": "array", "items": { "$ref": "#/$defs/GoldStructured" } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/GoldClaim" } }
  },
  "$defs": {
    "GoldMention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mention_id", "surface", "type"],
      "properties": {
        "mention_id": { "type": "string" },
        "surface": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "type": {
          "type": "string",
          "enum": ["music_recording", "place", "screen_work", "book", "person", "product", "brand_org", "software_app", "game"]
        },
        "gold_id": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["authority", "id"],
          "properties": {
            "authority": { "type": "string" },
            "id": { "type": "string" }
          }
        },
        "nil": { "enum": ["NIL_NO_ID", "NON_ENTITY", null] },
        "failed_queries": { "type": "array", "items": { "type": "string" } },
        "kb_snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "retrieved"],
          "properties": {
            "authority": { "type": "string" },
            "retrieved": { "type": "string", "format": "date" }
          }
        },
        "hard_case": { "type": "boolean" },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "description": "Structured staleness guard for Places (and any authority whose id churns): store the human-readable anchor so the label survives a stale/rotated external id (evaluation-methodology.md §3).",
          "properties": {
            "name": { "type": "string" },
            "address": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "url": { "type": "string" }
          }
        },
        "notes": { "type": "string" }
      },
      "oneOf": [
        {
          "description": "Linked: a non-null gold_id, and nil (if present) must be null.",
          "required": ["gold_id"],
          "properties": {
            "gold_id": { "type": "object" },
            "nil": { "type": "null" }
          }
        },
        {
          "description": "Unlinked: a non-null NIL label, and gold_id (if present) must be null.",
          "required": ["nil"],
          "properties": {
            "gold_id": { "type": "null" },
            "nil": { "type": "string", "enum": ["NIL_NO_ID", "NON_ENTITY"] }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": { "nil": { "const": "NIL_NO_ID" } },
            "required": ["nil"]
          },
          "then": {
            "required": ["failed_queries"],
            "properties": { "failed_queries": { "type": "array", "minItems": 1 } }
          }
        }
      ]
    },
    "GoldConcept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept_id"],
      "properties": {
        "concept_id": { "type": "string" },
        "authority": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "GoldStructured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaOrgType"],
      "properties": {
        "schemaOrgType": { "type": "string" },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string" },
              "value": { "description": "The gold slot value (any JSON scalar or structure)." }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["order", "text"],
            "properties": {
              "order": { "type": "integer" },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "GoldClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "statement"],
      "properties": {
        "claim_id": { "type": "string" },
        "statement": { "type": "string" }
      }
    }
  }
}
